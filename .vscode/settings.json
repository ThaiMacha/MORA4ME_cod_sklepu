{
  // Editor Configuration
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.wordWrap": "on",
  "editor.rulers": [
    120
  ],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.minimap.enabled": true,
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  // GitHub Copilot Configuration
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true,
    "php": true,
    "javascript": true,
    "typescript": true,
    "vue": true,
    "twig": true,
    "scss": true,
    "css": true,
    "json": true
  },
  "github.copilot.advanced": {
    "listCount": 10,
    "inlineSuggestCount": 3
  },
  // Files Configuration
  "files.associations": {
    "*.twig": "twig",
    "*.theme": "json",
    "*.vue": "vue",
    ".env*": "dotenv"
  },
  "files.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/var/cache": true,
    "**/var/log": true,
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/node_modules/**": true,
    "**/var/**": true
  },
  // PHP Configuration (Intelephense)
  "intelephense.files.maxSize": 3000000,
  "intelephense.files.exclude": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/var/**",
    "**/.git/**"
  ],
  "intelephense.completion.triggerParameterHints": true,
  "intelephense.completion.insertUseDeclaration": true,
  "intelephense.completion.fullyQualifyGlobalConstantsAndFunctions": false,
  "intelephense.format.enable": true,
  "intelephense.diagnostics.enable": true,
  // Formatting
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[twig]": {
    "editor.defaultFormatter": "mblode.twig-language-2"
  },
  // PHP CS Fixer
  "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
  "php-cs-fixer.rules": "@Symfony",
  "php-cs-fixer.config": "${workspaceFolder}/.php-cs-fixer.dist.php",
  "php-cs-fixer.allowRisky": true,
  "php-cs-fixer.onsave": true,
  // ESLint Configuration
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "twig"
  ],
  "eslint.workingDirectories": [
    "./src/Administration/Resources/app/administration",
    "./src/Storefront/Resources/app/storefront",
    {
      "mode": "auto"
    }
  ],
  // Jest Configuration
  "jest.rootPath": "src/Administration/Resources/app/administration",
  // PHP Problems Configuration
  "php.problems.exclude": {
    "vendor-bin/": true,
    "tests/integration/Storefront/Theme/ThemeTest.php": [
      "PHP2408"
    ]
  },
  // Vue/Volar Configuration
  "vue.inlayHints.missingProps": true,
  "vue.inlayHints.optionsWrapper": true,
  "vue.inlayHints.inlineHandlerLeading": true,
  "vue.complete.casing.tags": "kebab",
  "vue.complete.casing.props": "camel",
  // Terminal Configuration
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}",
  // Remote Configuration
  "remote.autoForwardPortsSource": "process",
  // Search Configuration
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "var/**": true,
    "vendor/**": true,
    "public/theme/**": true,
    "src/Storefront/Resources/app/storefront/dist/**": true,
    "tests/acceptance/test-results/**": true,
    "src/Administration/Resources/public/**": true,
    "src/Administration/Resources/app/administration/.jestcache/**": true
  },
  // Git Configuration
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.allowForcePush": false,
  // Emmet
  "emmet.includeLanguages": {
    "twig": "html",
    "vue-html": "html"
  },
  // Auto Save
  "files.autoSave": "onFocusChange",
  // TypeScript Configuration
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.includePackageJsonAutoImports": "off",
  // Breadcrumbs
  "breadcrumbs.enabled": true,
  "breadcrumbs.symbolPath": "on",
  // Explorer
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  // Workbench
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "readme",
  "workbench.tree.indent": 20
}