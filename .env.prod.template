# MORA4ME Production Environment Variables
# Copy this file to .env.prod and configure with your actual values

#====================
# Basic Configuration
#====================
APP_ENV=prod
APP_DEBUG=false
APP_SECRET=CHANGE-ME-32-CHARACTER-SECRET-KEY

#====================
# Database Configuration
#====================
DB_PASSWORD=YOUR-STRONG-DATABASE-PASSWORD-HERE
MYSQL_ROOT_PASSWORD=YOUR-STRONG-ROOT-PASSWORD-HERE

#====================
# Application URLs
#====================
APP_URL=https://mora4me.com
STOREFRONT_PROXY_URL=https://mora4me.com

#====================
# Email Configuration
#====================
MAILER_URL=smtp://username:password@smtp.gmail.com:587?encryption=tls
MAILER_DELIVERY_ADDRESS=admin@mora4me.com

#====================
# Cache Configuration
#====================
REDIS_URL=redis://redis:6379

#====================
# Search Configuration
#====================
OPENSEARCH_URL=http://opensearch:9200
SHOPWARE_ES_ENABLED=1
SHOPWARE_ES_INDEXING_ENABLED=1

#====================
# Performance Settings
#====================
SHOPWARE_CDN_STRATEGY_DEFAULT=physical_filename
SHOPWARE_CACHE_ID=mora4me_prod

#====================
# Optional: Monitoring & Notifications
#====================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/your/webhook/url
# NEW_RELIC_LICENSE_KEY=your-newrelic-license-key

#====================
# Security (Optional)
#====================
# TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# TRUSTED_HOSTS=mora4me.com,www.mora4me.com

#====================
# Shopware Specific
#====================
SHOPWARE_HTTP_CACHE_ENABLED=1
SHOPWARE_HTTP_DEFAULT_TTL=7200